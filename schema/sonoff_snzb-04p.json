{
    "version": 1,
    "mappings":{
        "eWeLink:SNZB-04P":"sonoff_snzb-04p"
    },
    "schemas": {
        "sonoff_snzb-04p": {
            "include": [
                "link_quality",
                "battery_percentage"
            ],
            "config": {
                "battery": 1,
                "deepsleep": 1
            },
            "switches": {
                "Contact": {
                    "has_value": "/device_info,attr_list -> attr_list.contains('Contact')",
                    "parse_value": "/device_info,attr_list -> attr_list['Contact'] ? true : false"
                },
                "Tamper": {
                    "has_value": "/device_info,attr_list -> attr_list.contains('FC11/2000')",
                    "parse_value": "/device_info,attr_list -> attr_list['FC11/2000'] ?  true : false"
                }
            }
        }
    }
}